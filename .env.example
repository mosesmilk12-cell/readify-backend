# Configure these in Render's Environment settings. Never commit the real secret key.
PAYSTACK_SECRET_KEY=sk_live_replace_with_your_paystack_secret
PUBLIC_BACKEND_URL=https://readify-backend-1.onrender.com
WEB_APP_URL=https://readifypro.com.ng/app.html
ALLOWED_ORIGINS=https://readifypro.com.ng,https://www.readifypro.com.ng

# Existing Readify services
OPENAI_API_KEY=replace_with_your_openai_key
GOOGLE_SERVICE_ACCOUNT_JSON=replace_with_your_firebase_service_account_json
REDIS_URL=replace_with_your_redis_url
